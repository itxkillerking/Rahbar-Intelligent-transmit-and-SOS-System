<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_secure"
            android:tint="@color/rahbar_primary" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="The Rahbar"
            android:textColor="@color/rahbar_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="QUICK SOS"
            android:textColor="@color/rahbar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">

        <!-- STATE 1: NORMAL -->
        <LinearLayout
            android:id="@+id/sos_state_normal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protection Active"
                android:textColor="@color/rahbar_primary_light"
                android:textSize="12sp"
                android:textStyle="bold" />
                
            <FrameLayout
                android:id="@+id/btn_sos_initial"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/widget_sos_button">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="SOS"
                    android:textColor="@color/rahbar_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tap for emergency help"
                android:textColor="@color/rahbar_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- STATE 2: CONFIRMATION -->
        <LinearLayout
            android:id="@+id/sos_state_confirm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Request"
                android:textColor="@color/rahbar_emergency_red"
                android:textSize="14sp"
                android:textStyle="bold" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Are you in danger?"
                android:textColor="@color/rahbar_text_primary"
                android:textSize="12sp" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">
                
                <TextView
                    android:id="@+id/btn_sos_im_safe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_secondary_button"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="I'M SAFE"
                    android:textColor="@color/rahbar_primary_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />
                    
                <TextView
                    android:id="@+id/btn_sos_not_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_danger_button"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="I'M NOT OK"
                    android:textColor="@color/rahbar_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- STATE 3: EMERGENCY ACTIVE -->
        <LinearLayout
            android:id="@+id/sos_state_active"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_emergency_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">
                
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@android:drawable/presence_online"
                    android:tint="@color/rahbar_emergency_red" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="EMERGENCY ACTIVE"
                    android:textColor="@color/rahbar_emergency_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Audio Evidence"
                android:textColor="@color/rahbar_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/sos_audio_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recording..."
                android:textColor="@color/rahbar_emergency_red"
                android:textSize="10sp" />
                
            <TextView
                android:id="@+id/btn_sos_resolve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/widget_secondary_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="I'M SAFE NOW"
                android:textColor="@color/rahbar_primary_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
