<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_secure"
            android:tint="@color/rahbar_primary" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="The Rahbar"
            android:textColor="@color/rahbar_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="EVIDENCE"
            android:textColor="@color/rahbar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Audio Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/rahbar_text_secondary" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Audio Evidence"
                android:textColor="@color/rahbar_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/evidence_audio_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Not Recording"
            android:textColor="@color/rahbar_text_secondary"
            android:textSize="11sp" />

        <!-- Primary Action -->
        <TextView
            android:id="@+id/btn_evidence_audio_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_primary_button"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="START AUDIO"
            android:textColor="@color/rahbar_white"
            android:textSize="12sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/btn_evidence_audio_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_secondary_button"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="STOP &amp; SAVE"
            android:textColor="@color/rahbar_primary_light"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Secondary Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_evidence_record_video"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="RECORD VIDEO"
            android:textColor="@color/rahbar_primary_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/btn_evidence_open"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="OPEN EVIDENCE"
            android:textColor="@color/rahbar_primary_light"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
